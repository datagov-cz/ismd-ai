# Application
# Runtime mode. Use "development" (or "dev") to enable development-only mock endpoints.
APP_ENVIRONMENT=development

# OIDC (local Keycloak)
# OpenID Connect issuer used to validate the issuer claim in bearer JWTs.
OIDC_ISSUER_URI=http://localhost:8081/realms/ismd
# URL providing the public keys used to verify bearer JWTs.
OIDC_JWK_SET_URI=http://localhost:8081/realms/ismd/protocol/openid-connect/certs

# SPARQL
# SPARQL endpoint queried for legal-act data.
APP_SPARQL_ENDPOINT_URL=https://opendata.eselpoint.gov.cz/sparql
# Maximum duration allowed for one SPARQL request.
APP_SPARQL_TIMEOUT=10s
# Total number of attempts made for a retryable SPARQL request.
APP_SPARQL_MAX_ATTEMPTS=3
# Delay between retryable SPARQL request attempts.
APP_SPARQL_RETRY_BACKOFF=250ms

# Usage limits
# Maximum number of LLM tokens a user may consume per day; use 0 to deny all usage.
APP_TOKENS_MAX_ALLOWED_PER_DAY=100000

# LLM
# Enables calls to the configured external LLM provider.
APP_LLM_ENABLED=false
# Provider API format to use. See README.md for the supported provider names.
APP_LLM_PROVIDER=OPENAI
# Provider endpoint override. Leave empty to use the selected provider's default URL.
APP_LLM_ENDPOINT_URL=
# Model identifier sent to the provider; it can also replace {model} in endpoint URLs.
APP_LLM_MODEL=gpt-4o-mini
# Provider credential. Replace this placeholder before enabling calls (not required for Ollama).
APP_LLM_API_KEY=replace-with-your-api-key
# Default maximum number of output tokens requested from the model.
APP_LLM_MAX_TOKENS=4096
# Optional sampling temperature; leave unset to use the provider's default.
# APP_LLM_TEMPERATURE=0.2
# Optional reasoning depth. Supported values depend on the provider and model; see README.md.
APP_LLM_REASONING_EFFORT=
# Optional text detail level for OpenAI-style APIs: low, medium, or high.
APP_LLM_TEXT_VERBOSITY=
# Maximum duration allowed for one LLM HTTP request.
APP_LLM_TIMEOUT=60s
# Requests provider-side interaction retention where supported; keep false for sensitive text.
APP_LLM_LOG_INTERACTIONS=false

# PostgreSQL
# Database server hostname. Docker Compose overrides this with the "postgres" service name.
APP_DB_HOST=localhost
# Database server TCP port.
APP_DB_PORT=5432
# PostgreSQL database name.
APP_DB_NAME=ismd
# PostgreSQL login username.
APP_DB_USER=ismd
# PostgreSQL login password. Replace this default outside local development.
APP_DB_PASSWORD=ismd
# Time zone applied to each new database connection.
APP_DB_TIME_ZONE=Europe/Prague
