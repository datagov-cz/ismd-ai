      "firstName": "Local",
      "lastName": "User",
      "email": "local-user@example.test",
      "emailVerified": true,
      "requiredActions": [],
      "credentials": [
        {
          "type": "password",
          "value": "local-password",
          "temporary": false
        }
      ]
    }
  ]
